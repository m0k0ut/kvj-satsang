---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TelegramMark from './TelegramMark.astro';
import RegistrationPanel from './RegistrationPanel.astro';
import { pageCopy, type Locale, type PageKey } from '../data/interior-copy';
import { withBase } from '../lib/urls';
import teacherImage from '../assets/radha-madam-pilgrimage.png';
import { Image } from 'astro:assets';

interface Props { locale: Locale; page: PageKey; }
const { locale, page } = Astro.props;
const isEnglish = locale === 'en';
const root = isEnglish ? '/en/' : '/';
const copy = pageCopy[locale][page];
const programs = (await getCollection('programs', ({ data }) => data.locale === locale && data.published)).sort((a, b) => a.data.order - b.data.order);
const resources = await getCollection('resources', ({ data }) => data.locale === locale && data.published);
const schedule = (await getCollection('schedule', ({ data }) => data.locale === locale))[0];
const title = `${copy.title} | ${isEnglish ? 'Krishnam Vande Jagadgurum' : 'కృష్ణం వందే జగద్గురుమ్'}`;

const classSteps = isEnglish
  ? [
      ['Schedule', 'Organizers announce the subject and class time in Telegram.'],
      ['Live class', 'Members join the Telegram video class for guided explanation and recitation.'],
      ['Practice', 'Shared text and audio support reading, repetition, and voice practice.'],
      ['Revision', 'Chapter, verse, and recitation exercises reinforce prior learning.'],
      ['Parayanam and seva', 'Learning connects to group parayanam, festivals, and service.'],
    ]
  : [
      ['సమయ ప్రకటన', 'విషయం, తరగతి సమయం Telegram లో నిర్వాహకులు ప్రకటిస్తారు.'],
      ['ప్రత్యక్ష తరగతి', 'వివరణ, పఠనం కోసం సభ్యులు Telegram వీడియో తరగతిలో చేరతారు.'],
      ['వ్యక్తిగత సాధన', 'పంచుకున్న పాఠ్యాలు, ఆడియోలతో చదవడం, పునరావృతం, స్వర సాధన చేస్తారు.'],
      ['పునశ్చరణ', 'అధ్యాయం, శ్లోకం, పఠన అభ్యాసాలు గత పాఠాన్ని బలపరుస్తాయి.'],
      ['పారాయణం మరియు సేవ', 'అధ్యయనం సామూహిక పారాయణం, పండుగలు, సేవతో కలుస్తుంది.'],
    ];

const teacherBiography = isEnglish
  ? [
      'Radha garu is the founder of Krishnam Vande Jagadgurum Satsang, its principal teacher, and spiritual guide. A respected educator and committed practitioner in the Sri Vaishnava tradition, she studied under the guidance of Sri Chinna Jeeyar Swamy. Her spiritual journey has embraced several forms of worship and today centers on Bhakti Yoga and devotion to Sri Krishna.',
      'Her study and teaching draw from the Vedas, Puranas, Srimad Bhagavatam, and the wider Vaishnava devotional tradition. A trained veena player, she also participated in a mass veena performance recognized with a Guinness World Records title.',
      'She believes education can create lasting change in society and lives by that conviction. After guiding her two sons through their education at IIT and BITS, she now teaches and supports a learning community of more than 1,400 students.',
      'Together with her husband, Mr. Venkateswarlu garu, she has built a life centered on family, learning, and Bhakti Yoga. Alongside her responsibilities at KVJ, she leads satsangs, annadanam initiatives, and devotional journeys to temples across India.',
    ]
  : [
      'రాధా గారు కృష్ణం వందే జగద్గురుమ్ సత్సంగం వ్యవస్థాపకురాలు, ప్రధాన గురువు, ఆధ్యాత్మిక మార్గదర్శి. గౌరవనీయ విద్యావేత్తగా, శ్రీ వైష్ణవ సంప్రదాయానికి నిబద్ధ సాధకురాలిగా, శ్రీ చిన్న జీయర్ స్వామివారి మార్గదర్శకత్వంలో అధ్యయనం చేశారు. వివిధ ఆరాధనా పద్ధతులను అనుసరించిన ఆమె ఆధ్యాత్మిక యాత్ర ప్రస్తుతం భక్తియోగం, శ్రీకృష్ణారాధనపై ప్రధానంగా కేంద్రీకృతమైంది.',
      'వేదాలు, పురాణాలు, శ్రీమద్భాగవతం మరియు వైష్ణవ భక్తి సంప్రదాయంపై ఆమె అధ్యయనం, బోధన ఆధారపడి ఉన్నాయి. వీణావాద్యంలో శిక్షణ పొందిన ఆమె, గిన్నిస్ వరల్డ్ రికార్డ్స్ గుర్తింపు పొందిన బృహత్ వీణా సమ్మేళన ప్రదర్శనలో కూడా పాల్గొన్నారు.',
      'విద్య సమాజంలో శాశ్వతమైన మార్పుకు దారి చూపుతుందని ఆమె విశ్వసిస్తారు. తన ఇద్దరు కుమారులను IIT, BITS విద్యాసంస్థల వరకు నడిపించిన అదే నిబద్ధతతో, నేడు 1,400 మందికి పైగా విద్యార్థులతో కూడిన అధ్యయన సమాజానికి బోధన, మార్గదర్శకత్వం అందిస్తున్నారు.',
      'భర్త శ్రీ వెంకటేశ్వర్లు గారితో కలిసి కుటుంబం, విద్య, భక్తియోగం కేంద్రంగా జీవితం నిర్మించుకున్నారు. KVJ బాధ్యతలతో పాటు సత్సంగాలు, అన్నదాన కార్యక్రమాలు, భారతదేశవ్యాప్తంగా దేవాలయ ఆధ్యాత్మిక యాత్రలను నిర్వహిస్తున్నారు.',
    ];

const galleryPhotos = [
  { file: 'kvj-community-01.webp', width: 1280, height: 591, en: 'KVJ members gathered during a temple visit', te: 'ఆలయ యాత్రలో కూడిన KVJ సభ్యులు' },
  { file: 'kvj-community-02.webp', width: 1440, height: 1080, en: 'KVJ members at a community gathering', te: 'సామూహిక సమావేశంలో KVJ సభ్యులు' },
  { file: 'kvj-community-03.webp', width: 591, height: 1280, en: 'Devotees together during a pilgrimage', te: 'ఆధ్యాత్మిక యాత్రలో కలిసి ఉన్న భక్తులు' },
  { file: 'kvj-community-04.webp', width: 1440, height: 665, en: 'The satsang community gathered for study and fellowship', te: 'అధ్యయనం, ఆత్మీయ సమావేశం కోసం కూడిన సత్సంగ సభ్యులు' },
  { file: 'kvj-community-05.webp', width: 1440, height: 1080, en: 'KVJ members gathered for satsang', te: 'సత్సంగం కోసం కూడిన KVJ సభ్యులు' },
  { file: 'kvj-community-06.webp', width: 1440, height: 665, en: 'Members serving food during annadanam', te: 'అన్నదాన సేవలో పాల్గొంటున్న సభ్యులు' },
  { file: 'kvj-community-07.webp', width: 1440, height: 655, en: 'KVJ members at a devotional program', te: 'భక్తి కార్యక్రమంలో KVJ సభ్యులు' },
  { file: 'kvj-community-08.webp', width: 1440, height: 1080, en: 'Members visiting a Shiva temple', te: 'శివాలయాన్ని దర్శిస్తున్న సభ్యులు' },
  { file: 'kvj-community-09.webp', width: 1280, height: 591, en: 'KVJ group portrait at a devotional gathering', te: 'భక్తి సమావేశంలో KVJ బృంద చిత్రం' },
  { file: 'kvj-community-10.webp', width: 1280, height: 591, en: 'Members gathered before a pilgrimage journey', te: 'ఆధ్యాత్మిక యాత్రకు ముందు కూడిన సభ్యులు' },
  { file: 'kvj-community-11.webp', width: 1440, height: 666, en: 'KVJ members during a study session', te: 'అధ్యయన సమావేశంలో KVJ సభ్యులు' },
  { file: 'kvj-community-12.webp', width: 1280, height: 960, en: 'Community fellowship after satsang', te: 'సత్సంగం అనంతరం ఆత్మీయ సమావేశం' },
  { file: 'kvj-community-13.webp', width: 1280, height: 964, en: 'Pilgrimage group resting on temple steps', te: 'ఆలయ మెట్లపై విశ్రాంతి తీసుకుంటున్న యాత్రా బృందం' },
  { file: 'kvj-community-14.webp', width: 1075, height: 821, en: 'KVJ members at a temple gathering', te: 'ఆలయ సమావేశంలో KVJ సభ్యులు' },
  { file: 'kvj-community-15.webp', width: 1440, height: 1081, en: 'A member receiving recognition at a temple event', te: 'ఆలయ కార్యక్రమంలో సత్కారం అందుకుంటున్న సభ్యురాలు' },
  { file: 'kvj-community-16.webp', width: 1280, height: 964, en: 'KVJ members gathered at a temple entrance', te: 'ఆలయ ప్రవేశద్వారం వద్ద కూడిన KVJ సభ్యులు' },
  { file: 'kvj-community-17.webp', width: 1440, height: 665, en: 'Pilgrimage group in a temple courtyard', te: 'ఆలయ ప్రాంగణంలో యాత్రా బృందం' },
  { file: 'kvj-community-18.webp', width: 1280, height: 720, en: 'KVJ group at a temple complex', te: 'ఆలయ సముదాయంలో KVJ బృందం' },
  { file: 'kvj-community-19.webp', width: 1440, height: 665, en: 'Members gathered after temple darshan', te: 'ఆలయ దర్శనం అనంతరం కూడిన సభ్యులు' },
  { file: 'kvj-community-20.webp', width: 1280, height: 575, en: 'KVJ members during a temple visit', te: 'ఆలయ యాత్రలో KVJ సభ్యులు' },
  { file: 'kvj-community-21.webp', width: 1440, height: 1080, en: 'Group recitation inside a temple', te: 'ఆలయంలో సామూహిక పారాయణం' },
  { file: 'kvj-community-22.webp', width: 1440, height: 959, en: 'Recognition at a community event', te: 'సామాజిక కార్యక్రమంలో సత్కారం' },
] as const;
---

<BaseLayout title={title} description={copy.description} locale={locale}>
  <section class="page-hero">
    <div class="shell page-hero-inner">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p>{copy.description}</p>
    </div>
  </section>

  {page === 'programs' && (
    <section class="section interior-section">
      <div class="shell content-grid">
        {programs.map((program, index) => (
          <article class="content-card program-card">
            <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
            <h2>{program.data.title}</h2>
            <p>{program.data.description}</p>
            <dl>
              <div><dt>{isEnglish ? 'Format' : 'విధానం'}</dt><dd>{program.data.format}</dd></div>
              <div><dt>{isEnglish ? 'Current stage' : 'ప్రస్తుత స్థాయి'}</dt><dd>{program.data.currentStage}</dd></div>
            </dl>
          </article>
        ))}
      </div>
      <div class="shell notice-card"><strong>{isEnglish ? 'Schedule note' : 'సమయ సూచన'}</strong><p>{schedule?.data.message}</p></div>
    </section>
  )}

  {page === 'about' && (
    <section class="section interior-section">
      <div class="shell teacher-grid">
        <figure class="teacher-photo">
          <Image src={teacherImage} alt={isEnglish ? 'Smt. Radha ji in prayer during a temple pilgrimage' : 'ఆలయ యాత్రలో ధ్యానం చేస్తున్న శ్రీమతి రాధాజీ'} width={760} quality={88} />
          <figcaption>{isEnglish ? 'Photo supplied by KVJ Satsang' : 'KVJ సత్సంగం అందించిన చిత్రం'}</figcaption>
        </figure>
        <div class="teacher-profile">
          <p class="eyebrow">{isEnglish ? 'Founder of KVJ Satsang · Principal teacher · Spiritual guide' : 'KVJ సత్సంగం వ్యవస్థాపకురాలు · ప్రధాన గురువు · ఆధ్యాత్మిక మార్గదర్శి'}</p>
          <h2>{isEnglish ? 'Smt. Radha ji' : 'శ్రీమతి రాధాజీ'}</h2>
          <div class="teacher-biography">
            {teacherBiography.map((paragraph, index) => <p class={index === 0 ? 'large-copy' : undefined}>{paragraph}</p>)}
          </div>
          <div class="value-grid">
            <article><strong>1,400+</strong><h3>{isEnglish ? 'Learners guided' : 'విద్యార్థులకు మార్గదర్శనం'}</h3><p>{isEnglish ? 'A growing community built through accessible teaching.' : 'అందరికీ చేరువైన బోధనతో అభివృద్ధి చెందుతున్న సమాజం.'}</p></article>
            <article><strong>{isEnglish ? 'Study' : 'అధ్యయనం'}</strong><h3>{isEnglish ? 'Scripture and tradition' : 'శాస్త్రం మరియు సంప్రదాయం'}</h3><p>{isEnglish ? 'Vedas, Puranas, Bhagavatam, recitation, and revision.' : 'వేదాలు, పురాణాలు, భాగవతం, పఠనం, పునశ్చరణ.'}</p></article>
            <article><strong>{isEnglish ? 'Seva' : 'సేవ'}</strong><h3>{isEnglish ? 'Devotion in action' : 'ఆచరణలో భక్తి'}</h3><p>{isEnglish ? 'Satsangs, annadanam, and temple journeys across India.' : 'సత్సంగాలు, అన్నదానం, భారతదేశవ్యాప్తంగా ఆలయ యాత్రలు.'}</p></article>
          </div>
        </div>
      </div>
    </section>
  )}

  {page === 'classes' && (
    <section class="section interior-section">
      <div class="shell timeline">
        {classSteps.map(([step, text], index) => (
          <article class="timeline-step">
            <div class="timeline-number">{index + 1}</div>
            <div><h2>{step}</h2><p>{text}</p></div>
          </article>
        ))}
      </div>
      <div class="shell notice-card telegram-notice"><TelegramMark /><p>{isEnglish ? 'A Telegram account, a quiet place to listen, and time for regular practice. Organizers share class schedules directly with participants. All times use Indian Standard Time.' : 'Telegram ఖాతా, ప్రశాంతంగా వినగల స్థలం, నిరంతర సాధనకు సమయం అవసరం. తరగతి సమయాలను నిర్వాహకులు సభ్యులతో నేరుగా పంచుకుంటారు. అన్ని సమయాలు భారతీయ ప్రామాణిక కాలమానం ప్రకారం ఉంటాయి.'}</p></div>
    </section>
  )}

  {page === 'gallery' && (
    <section class="section interior-section">
      <div class="shell gallery-intro-card">
        <span aria-hidden="true">✦</span>
        <div>
          <h2>{isEnglish ? 'Life in the satsang' : 'సత్సంగ జీవన దృశ్యాలు'}</h2>
          <p>{isEnglish ? 'Moments of prayer, learning, pilgrimage, fellowship, recognition, and annadanam from the KVJ community.' : 'KVJ సమాజంలోని ప్రార్థన, అధ్యయనం, ఆలయ యాత్రలు, ఆత్మీయ సమావేశాలు, సత్కారాలు, అన్నదాన సేవల దృశ్యాలు.'}</p>
        </div>
      </div>
      <div class="shell community-gallery" aria-label={isEnglish ? 'KVJ Satsang photo gallery' : 'KVJ సత్సంగం చిత్ర ప్రదర్శన'}>
        {galleryPhotos.map((photo, index) => (
          <figure class="community-photo">
            <img
              src={withBase(`/gallery/community/${photo.file}`)}
              alt={isEnglish ? photo.en : photo.te}
              width={photo.width}
              height={photo.height}
              loading={index < 3 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
            <figcaption>{isEnglish ? photo.en : photo.te}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {page === 'resources' && (
    <section class="section interior-section">
      <div class="shell content-grid resource-grid">
        {resources.map((resource) => (
          <article class="content-card resource-card">
            <span class="resource-type">{resource.data.type}</span>
            <h2>{resource.data.title}</h2>
            <p>{resource.data.description}</p>
            {resource.data.availability === 'available' && resource.data.url
              ? <a class="text-link" href={resource.data.url}>{isEnglish ? 'Open resource' : 'వనరు తెరవండి'} <span aria-hidden="true">↗</span></a>
              : <span class="status-chip">{isEnglish ? 'Summary' : 'సారాంశం'}</span>}
          </article>
        ))}
      </div>
      <div class="shell notice-card"><strong>{isEnglish ? 'Resource policy' : 'వనరుల విధానం'}</strong><p>{isEnglish ? 'This website provides public summaries only. Study files, audio practice, and class materials remain in the Telegram learning environment.' : 'ఈ వెబ్‌సైట్‌లో పబ్లిక్ సారాంశాలు మాత్రమే ఉంటాయి. పాఠ్యాలు, ఆడియో సాధన, తరగతి వనరులు Telegram అధ్యయన వాతావరణంలోనే ఉంటాయి.'}</p></div>
    </section>
  )}

  {page === 'join' && (
    <section class="section interior-section">
      <div class="shell join-grid">
        <div class="join-card">
          <p class="eyebrow">{isEnglish ? 'How participation works' : 'పాల్గొనే విధానం'}</p>
          <h2>{isEnglish ? 'Learn the rhythm of the satsang' : 'సత్సంగం అధ్యయన విధానాన్ని తెలుసుకోండి'}</h2>
          <ol>
            <li><span>1</span>{isEnglish ? 'Review the programs and class format.' : 'కార్యక్రమాలు, తరగతి విధానం తెలుసుకోండి.'}</li>
            <li><span>2</span>{isEnglish ? 'Organizers coordinate Telegram access directly within the community.' : 'Telegram యాక్సెస్‌ను నిర్వాహకులు సమాజంలో నేరుగా సమన్వయం చేస్తారు.'}</li>
            <li><span>3</span>{isEnglish ? 'Follow the class schedule, study material, and practice guidance shared there.' : 'అక్కడ పంచుకునే తరగతి సమయాలు, పాఠ్యాలు, సాధన సూచనలు పాటించండి.'}</li>
          </ol>
        </div>
        <aside class="join-status">
          <TelegramMark inverse label={isEnglish ? 'Classes on Telegram' : 'Telegram లో తరగతులు'} />
          <h2>{isEnglish ? 'A private learning environment' : 'గోప్యమైన అధ్యయన వాతావరణం'}</h2>
          <p>{isEnglish ? 'KVJ uses Telegram for live teaching, announcements, study material, audio practice, and revision. Group details are intentionally not published on this website.' : 'ప్రత్యక్ష బోధన, ప్రకటనలు, పాఠ్యాలు, ఆడియో సాధన, పునశ్చరణ కోసం KVJ Telegram ను ఉపయోగిస్తుంది. గ్రూప్ వివరాలను ఈ వెబ్‌సైట్‌లో ఉద్దేశపూర్వకంగా ప్రచురించము.'}</p>
          <p class="telegram-disclaimer">{isEnglish ? 'KVJ Satsang is independent and is not affiliated with Telegram.' : 'KVJ సత్సంగం స్వతంత్ర సంస్థ. Telegram తో అనుబంధం లేదు.'}</p>
          <a class="button" href={withBase(`${root}register/`)}>{isEnglish ? 'Register interest' : 'నమోదు చేసుకోండి'} <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </section>
  )}

  {page === 'register' && <RegistrationPanel locale={locale} />}
</BaseLayout>
